{
  "manifest_version": 3,
  "name": "Geo Helper",
  "version": "8.2",
  "description": "地理信息展示工具",
  "permissions": ["storage"],
  "host_permissions": [
    "*://tuxun.fun/*",
    "*://*.tuxun.fun/*",
    "*://*.chao-fan.com/*",
    "*://*.googleapis.com/*",
    "*://*.google.com/*",
    "*://restapi.amap.com/*",
    "*://nominatim.openstreetmap.org/*",
    "*://*.bdimg.com/*",
    "*://*.map.qq.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://tuxun.fun/*", "*://*.tuxun.fun/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["*://tuxun.fun/*", "*://*.tuxun.fun/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": { "default_popup": "popup.html" }
}
